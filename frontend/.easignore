# Reduce EAS Build upload size by excluding unnecessary files
# See: https://expo.fyi/eas-build-archive

# Backend folder (not used by Expo build)
backend/
admin_panel/
memory/

# Local builds & cache
.expo/
dist/
web-build/
*.tsbuildinfo
.metro-cache/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Test files
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentation & misc
README.md
*.md
.git/
