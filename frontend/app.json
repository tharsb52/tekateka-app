{
  "expo": {
    "name": "TekaTeka",
    "slug": "frontend",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab6140a0-3dfb-4ce8-b47a-88f643de12cc",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tekateka",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tekateka.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Dictez vos produits et ventes facilement",
        "NSMicrophoneUsageDescription": "Enregistrez vos donnees en parlant",
        "NSCameraUsageDescription": "Prenez une photo de profil",
        "NSPhotoLibraryUsageDescription": "Choisissez une photo de profil"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fef3e7"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.tekateka.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#fef3e7"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choisissez une photo de profil",
          "cameraPermission": "Prenez une photo de profil"
        }
      ],
      "expo-web-browser",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ab6140a0-3dfb-4ce8-b47a-88f643de12cc"
      }
    }
  }
}
