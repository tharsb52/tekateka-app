# TekaTeka Frontend Environment Variables Template
# Copy to `.env` and fill in. Do NOT commit `.env`.

# Backend API base URL (no trailing slash, no /api suffix)
# Production: https://low-data-shop.emergent.host
# Preview:    https://low-data-shop.preview.emergentagent.com
EXPO_PUBLIC_BACKEND_URL=https://low-data-shop.emergent.host

# OTP provider: "firebase" (default) or "africas_talking"
EXPO_PUBLIC_OTP_PROVIDER=africas_talking

# Expo internal (set by Expo dev server / EAS — DO NOT change manually)
# EXPO_TUNNEL_SUBDOMAIN=
# EXPO_PACKAGER_HOSTNAME=
# EXPO_PACKAGER_PROXY_URL=
