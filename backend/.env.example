# TekaTeka Backend Environment Variables Template
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` to git — secrets must live ONLY in your deployment platform.

# Database
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# Africa's Talking (SMS / OTP fallback)
AT_USERNAME="sandbox"
AT_API_KEY=""

# Admin backoffice
ADMIN_PASSWORD=""

# Stripe (https://dashboard.stripe.com/apikeys)
# Use sk_test_... / pk_test_... for development, sk_live_... / pk_live_... for production.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public URL of your deployed frontend (used in Stripe success_url / cancel_url)
FRONTEND_BASE_URL="https://tekateka.app"

# JWT signing key (set a long random string in production)
JWT_SECRET=""
